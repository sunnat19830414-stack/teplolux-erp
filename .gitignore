# ─────────────────────────────────────────────────────────────────────────────
# Секреты. Никогда не коммитить.
# В репозитории лежат только *.example.php с заглушками — рабочие файлы с
# настоящими паролями и API-ключами остаются на сервере и сюда не попадают.
# ─────────────────────────────────────────────────────────────────────────────
custom/*/config.php
custom/*/config/config.zhomi.php
custom/*/config/config.turk.php
custom/*/config/db.local.php
!custom/*/*.example.php
!custom/*/config/*.example.php

.env
.env.*
*.key
*.pem
*.p12
*.pfx

# ─────────────────────────────────────────────────────────────────────────────
# Dolibarr: конфиг с реквизитами БД и хранилище документов.
# documents/ — это НЕ код: там реальные счета, контракты и накладные клиентов.
# ─────────────────────────────────────────────────────────────────────────────
conf/
conf.php
documents/
custom/*/documents/
install.lock

# ─────────────────────────────────────────────────────────────────────────────
# Логи, кэш, временное
# ─────────────────────────────────────────────────────────────────────────────
*.log
logs/
cache/
temp/
tmp/
*.tmp
*.cache
sessions/

# ─────────────────────────────────────────────────────────────────────────────
# Выгрузки и бэкапы (Excel-файлы формируются на лету, хранить их незачем)
# ─────────────────────────────────────────────────────────────────────────────
*.bak
*.sql
*.dump
*.zip
*.xls
*.xlsx

# ─────────────────────────────────────────────────────────────────────────────
# Зависимости (в проекте не используются, но пусть будет на будущее)
# ─────────────────────────────────────────────────────────────────────────────
vendor/
node_modules/
composer.lock

# ─────────────────────────────────────────────────────────────────────────────
# Редакторы и ОС
# ─────────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-*
*.swp
*~
Thumbs.db
desktop.ini
$RECYCLE.BIN/
